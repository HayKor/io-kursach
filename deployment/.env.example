# Copy to .env.dev and adjust: cp .env.example .env.dev
POSTGRES_DB=sudv
POSTGRES_USER=sudv
POSTGRES_PASSWORD=change-me

# Generate a real value with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call the API from a browser (the web client)
CORS_ORIGINS=http://localhost:8081
